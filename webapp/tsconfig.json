{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["ES2017", "DOM", "DOM.Iterable"],
    "module": "ES2015",
    "moduleResolution": "node",
    "allowJs": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react",
    "skipLibCheck": true,
    "strict": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "noEmit": true,
    "baseUrl": "src"
  },
  "include": ["src/**/*"]
}
